# Docker base image tag. AirSim 호환성 검토 후 팀 공통 버전으로 확정한다.
PYTHON_VERSION=3.11-slim

# Host ports exposed by Docker Compose.
MIDDLEWARE_PORT=8000
ORCHESTRATOR_PORT=8001

# AirSim currently runs outside this Compose stack.
AIRSIM_HOST=host.docker.internal
AIRSIM_PORT=41451

# Application log level.
LOG_LEVEL=INFO

